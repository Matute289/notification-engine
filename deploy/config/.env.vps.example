# VPS Production Environment — notification-engine
# Copy to /opt/notification-engine/.env.vps on the VPS
# NEVER commit this file with real credentials

# ── Application ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
HTTP_ADDR=:8080
PROVIDER_MODE=mock   # Change to "real" after configuring credentials below

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=notif
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=notif

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=notif
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGODB_URI=mongodb://notif:CHANGE_ME_STRONG_PASSWORD@mongodb:27017
MONGODB_DATABASE=notification_engine
TEMPLATE_CACHE_TTL=5m

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_DB=0

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=notif
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_URL=amqp://notif:CHANGE_ME_STRONG_PASSWORD@rabbitmq:5672/

# ── Auth ─────────────────────────────────────────────────────────────────────
APP_CLIENTS=demo-app:CHANGE_ME_APP_SECRET

# ── Rate limits ──────────────────────────────────────────────────────────────
RATELIMIT_PUSH_PER_HOUR=20
RATELIMIT_SMS_PER_HOUR=5
RATELIMIT_EMAIL_PER_HOUR=10
APP_KEY_RATE_LIMIT=0
APP_KEY_RATE_WINDOW=1s

# ── Workers ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=8
MAX_RETRIES=5

# ── Credentials (fill when switching to PROVIDER_MODE=real) ─────────────────
# See: docs/plans/notification-engine-credentials.md for full setup guide

# Email (choose one provider)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# SMS — Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Telegram
# TELEGRAM_BOT_TOKEN=

# WhatsApp
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# LINE
# LINE_CHANNEL_ACCESS_TOKEN=
